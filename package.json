    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "pino": "^10.4.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
