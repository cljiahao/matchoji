# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Reverse proxy trust — set to the number of trusted proxy hops (1 = ALB → App, 2 = ALB → Traefik → App); leave empty/unset when there is no proxy (headers not trusted), e.g. local dev
TRUST_PROXY=

# Supabase (Postgres, Auth, Storage) — see docs/superpowers/specs/2026-09-14-matchoji-design.md
# Publishable key (sb_publishable_...) replaces the legacy anon key. It is safe to expose:
# RLS guards the data. No secret key is needed: the app never bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Third-party API tokens
# API_KEY=
